---
layout: base.njk
title: "All Posts"
---

<div class="hero-container top-head">
    <div class="hero">
    <h1 class="zero-margin header inter">ALL POSTS</h1>
    </div>
</div>
<section class="posts-section">
  <div class="post-grid open-sans">
      {% for post in (collections.posts | reverse)%}
      <article class="post-card">
          <h3 class="zero-margin"><a href="{{ post.url | url }}">{{ post.data.title }}</a></h3>

          <p class="zero-margin post-by">
              <time>{{ post.date | numericDate }}</time>
              <a>{{ post.data.author }}</a>
          </p>


          <div class="post-info">
              <p class="zero-margin post-desc">{{ post.data.description }}</p>
              <p class="zero-margin post-link"><a href="{{ post.url | url }}" class="btn">READ POST </a></p>
          </div>
      </article>
      {% endfor %}
  </div>
</section>
